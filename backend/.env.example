# 服务器配置
PORT=3001
NODE_ENV=production

# PostgreSQL 数据库配置（Railway 会自动提供这些变量）
# DATABASE_URL=postgresql://user:password@host:port/database
# 或者单独配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=binance_alpha
DB_USER=postgres
DB_PASSWORD=postgres123

# Redis 配置（Railway 会自动提供）
# REDIS_URL=redis://default:password@host:port
# 或者单独配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS 允许的前端域名（用逗号分隔多个域名）
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# 管理接口令牌（/api/cleanup、/api/cleanup/logs、/api/database/stats）
# 不配置则这些接口返回 503。生成方式：openssl rand -hex 32
# 调用示例：curl -X POST -H "Authorization: Bearer $ADMIN_TOKEN" http://localhost:3001/api/cleanup
ADMIN_TOKEN=

# 反向代理信任（影响按 IP 限流）：代理跳数、true/false 或 IP 列表
# 生产环境未设置时默认 1（适用于 Railway 等单层代理）；直接暴露在公网时设为 false
TRUST_PROXY=

# 日志级别
LOG_LEVEL=info
